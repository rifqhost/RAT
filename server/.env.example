# Server port
PORT=8080

# Host the server binds to
HOST=0.0.0.0

# Public base URL used in pairing/deep-link payloads
PUBLIC_BASE_URL=http://localhost:8080

# JWT / token secrets (CHANGE IN PRODUCTION - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-generate-a-random-48-byte-hex
PAIRING_TOKEN_SECRET=change-me-generate-a-random-48-byte-hex

# Token lifetimes (seconds)
AUTH_TOKEN_TTL=3600
PAIRING_CODE_TTL=300
SESSION_TOKEN_TTL=3600

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Data store file (relative to server/). Change to a non-repo path in production.
DATA_FILE=./data/store.json

# STUN/TURN configuration advertised during WebRTC offer.
# Entries are URL strings, or objects for authenticated servers:
#   [{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]
STUN_SERVERS=["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]
TURN_SERVERS=[]

# CORS allowed origins (comma separated)
CORS_ORIGINS=*